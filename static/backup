    border: 1px solid #d9dee5;

    border-left: 4px solid var(--school-border);

    border-radius: 7px;

    padding: 9px 10px;
}


/* =========================================================
   Teacher Weekly Schedule
   ========================================================= */

.teacher-schedule-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 25px;
    gap: 20px;
}

.teacher-schedule-header h1 {
    margin: 0;
}

.teacher-controls {
    display: flex;
    align-items: center;
    gap: 10px;
}

.teacher-controls select {
    min-width: 180px;
    padding: 8px 10px;
    border: 1px solid #ccc;
    border-radius: 6px;
    background: white;
    font-size: 13px;
}

.week-navigation {
    display: flex;
    gap: 5px;
}

.week-navigation button {
    padding: 8px 12px;
    border: 1px solid #ccc;
    border-radius: 6px;
    background: white;
    color: #333;
    cursor: pointer;
    font-size: 12px;
}

.week-navigation button:hover {
    background: #f5f5f5;
}


/* Teacher schedule cards */

.teacher-schedule-inherited {
    margin-top: 7px;
    font-size: 10px;
    color: #888;
    font-style: italic;
}


/* Empty day */

.teacher-empty-day {
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;

    background: white;
    border: 1px solid #eee;
    border-radius: 7px;

    color: #bbb;
    font-size: 12px;
}


/* Responsive */

@media (max-width: 1100px) {

    .teacher-schedule-header {
        flex-direction: column;
        align-items: stretch;
    }

    .teacher-controls {
        justify-content: space-between;
    }

}


@media (max-width: 800px) {

    .weekly-columns {
        grid-template-columns: 1fr;
    }

    .teacher-controls {
        flex-direction: column;
        align-items: stretch;
    }

    .teacher-controls select {
        width: 100%;
    }

    .week-navigation {
        justify-content: space-between;
    }

}

.teacher-schedule-link {
    display: inline-block;
    padding: 8px 12px;
    border: 1px solid #ccc;
    border-radius: 6px;
    background: white;
    color: #333;
    text-decoration: none;
    font-size: 13px;
}

.teacher-schedule-link:hover {
    background: #f5f5f5;
}

.course-edit {
    margin-top: 4px;
}


.course-edit-field {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-bottom: 7px;
}


.course-edit-field label {
    font-size: 10px;
    font-weight: 600;
    color: #666;
}


.course-edit-field input {
    width: 100%;
    box-sizing: border-box;
    padding: 5px 6px;
    border: 1px solid #bbb;
    border-radius: 5px;
    background: white;
    font-size: 12px;
    font-family: inherit;
}


.course-edit-field input:focus {
    outline: none;
    border-color: #777;
}


.course-edit-time-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
}


.course-edit-actions {
    display: flex;
    gap: 5px;
    margin-top: 8px;
}


.course-save-button {
    padding: 5px 10px;
    border: none;
    border-radius: 5px;
    background: #222;
    color: white;
    font-size: 11px;
    cursor: pointer;
}


.course-save-button:hover {
    opacity: 0.85;
}


.course-save-button:disabled {
    opacity: 0.5;
    cursor: default;
}


.course-cancel-button {
    padding: 5px 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
    background: white;
    color: #555;
    font-size: 11px;
    cursor: pointer;
}


.course-cancel-button:hover {
    background: #f5f5f5;
}


.course-edit-message {
    margin-top: 6px;
    font-size: 10px;
    line-height: 1.3;
}


.course-edit-error {
    color: #b42318;
}


.course-edit-success {
    color: #26734d;
}


/* =========================================================
   View Schedule
   ========================================================= */

.view-schedule-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 25px;
}

.view-schedule-header h1 {
    margin: 0;
}

.view-controls {
    display: flex;
    align-items: center;
    gap: 10px;
}

.view-date-selector {
    display: flex;
    gap: 6px;
}

.view-date-selector input {
    padding: 8px 10px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-family: inherit;
}

.view-date-selector button {
    padding: 8px 12px;
    border: 1px solid #ccc;
    border-radius: 6px;
    background: white;
    color: #333;
    cursor: pointer;
}

.view-date-selector button:hover {
    background: #f5f5f5;
}

.view-navigation {
    display: flex;
    gap: 5px;
}

.view-navigation button {
    padding: 8px 12px;
    border: 1px solid #ccc;
    border-radius: 6px;
    background: white;
    color: #333;
    cursor: pointer;
    font-size: 12px;
}

.view-navigation button:hover {
    background: #f5f5f5;
}


/* =========================================================
   View course cards
   ========================================================= */

.view-course-block {
    padding: 10px;
}

.view-course-block .course-school {
    font-size: 11px;
}

.view-course-block .course-name {
    font-size: 14px;
}

.view-course-block .course-time {
    font-size: 12px;
    margin-bottom: 6px;
}

.view-course-block .course-details {
    margin-bottom: 7px;
}


/* =========================================================
   Teachers
   ========================================================= */

.view-teachers {
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    font-size: 11px;
    line-height: 1.4;
    color: #444;
}

.view-teacher-label {
    font-weight: 600;
    color: #666;
}

.view-unassigned {
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    font-size: 11px;
    color: #999;
    font-style: italic;
}


/* =========================================================
   Responsive
   ========================================================= */

@media (max-width: 1100px) {

    .view-schedule-header {
        flex-direction: column;
        align-items: stretch;
    }

    .view-controls {
        justify-content: space-between;
    }

}


@media (max-width: 800px) {

    .view-controls {
        flex-direction: column;
        align-items: stretch;
    }

    .view-date-selector {
        width: 100%;
    }

    .view-date-selector input {
        flex: 1;
    }

    .view-navigation {
        justify-content: space-between;
    }

}

.main-nav {
    display: flex;
    gap: 18px;
    margin-left: 30px;
}

.main-nav a {
    color: #666;
    text-decoration: none;
    font-size: 13px;
}

.main-nav a:hover {
    color: #222;
}

/* =========================================================
   Teacher List
   ========================================================= */

.teacher-list-header {
    margin-bottom: 25px;
}

.teacher-list-header h1 {
    margin: 0 0 6px 0;
}

.teacher-list-header p {
    margin: 0;
    color: #777;
    font-size: 13px;
}

.teacher-list {
    display: grid;
    grid-template-columns: repeat(
        auto-fill,
        minmax(180px, 1fr)
    );
    gap: 12px;
    max-width: 900px;
}

.teacher-card {
    display: block;
    padding: 15px;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: white;
    color: inherit;
    text-decoration: none;
    transition:
        border-color 0.15s,
        box-shadow 0.15s,
        transform 0.15s;
}

.teacher-card:hover {
    border-color: #aaa;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transform: translateY(-1px);
}

.teacher-card-name {
    font-size: 14px;
    font-weight: 600;
    color: #222;
}

.teacher-card-status {
    margin-top: 5px;
    font-size: 11px;
    color: #888;
}

@media (max-width: 600px) {

    .teacher-list {
        grid-template-columns: 1fr;
    }

}


/* =========================================================
   Add Course
   ========================================================= */

.add-course-button {
    padding: 8px 12px;
    border: none;
    border-radius: 6px;
    background: #222;
    color: white;
    font-size: 12px;
    cursor: pointer;
}

.add-course-button:hover {
    opacity: 0.85;
}


.add-course-panel {
    position: fixed;
    inset: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    background: rgba(0, 0, 0, 0.25);

    z-index: 1000;
}


.add-course-box {
    width: 420px;
    max-width: calc(100vw - 30px);

    max-height: calc(100vh - 40px);
    overflow-y: auto;

    padding: 22px;

    background: white;
    border-radius: 10px;

    box-shadow:
        0 10px 35px rgba(0, 0, 0, 0.18);

    box-sizing: border-box;
}


.add-course-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;

    margin-bottom: 20px;
}


.add-course-header h2 {
    margin: 0 0 5px 0;
    font-size: 20px;
}


.add-course-header p {
    margin: 0;

    color: #777;
    font-size: 12px;
}


.close-course-button {
    width: 28px;
    height: 28px;

    border: none;
    border-radius: 5px;

    background: #f5f5f5;
    color: #555;

    font-size: 20px;
    line-height: 1;

    cursor: pointer;
}


.close-course-button:hover {
    background: #eee;
}


.add-course-field {
    display: flex;
    flex-direction: column;

    gap: 4px;
    margin-bottom: 12px;
}


.add-course-field label {
    font-size: 11px;
    font-weight: 600;
    color: #666;
}


.add-course-field input,
.add-course-field select {
    width: 100%;
    box-sizing: border-box;

    padding: 7px 8px;

    border: 1px solid #ccc;
    border-radius: 6px;

    background: white;

    font-family: inherit;
    font-size: 12px;
}


.add-course-field input:focus,
.add-course-field select:focus {
    outline: none;
    border-color: #777;
}


.add-course-time-row {
    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 10px;
}


.add-course-actions {
    display: flex;
    gap: 7px;

    margin-top: 18px;
}


.add-course-save-button {
