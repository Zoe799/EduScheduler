body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #f5f6f8;
    color: #222;
}


/* =========================
   Top bar
   ========================= */

.topbar {
    height: 60px;
    background: white;
    border-bottom: 1px solid #ddd;

    display: flex;
    align-items: center;

    padding: 0 30px;
}


.logo {
    font-size: 20px;
    font-weight: 600;
}


/* =========================
   Main container
   ========================= */

.container {
    max-width: 1500px;
    margin: 30px auto;
    padding: 0 20px;
}


/* =========================
   Header
   ========================= */

.schedule-header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 25px;
}


.schedule-header h1 {
    margin: 0;
}


.week-range {
    color: #777;
    margin-top: 5px;
}


.date-selector {
    display: flex;
    gap: 8px;
}


.date-selector input {
    padding: 8px 10px;

    border: 1px solid #ccc;
    border-radius: 6px;
}


.date-selector button {
    padding: 8px 15px;

    border: none;
    border-radius: 6px;

    background: #222;
    color: white;

    cursor: pointer;
}


/* =========================
   Header cells
   ========================= */

.time-column {
    border-left: none;
}


.day-name {
    font-size: 15px;
}


.day-date {
    margin-top: 4px;

    font-size: 13px;

    color: #777;
}




.empty-cell {
    height: 100%;

    display: flex;

    align-items: center;
    justify-content: center;

    color: #ccc;
}


/* =========================
   Course block
   ========================= */

.course-block {
    background: #f8fafc;

    border: 1px solid #d9dee5;

    border-radius: 8px;

    padding: 12px;

    margin-bottom: 10px;

    position: relative;
}


.course-block:last-child {
    margin-bottom: 0;
}


.course-name {
    font-size: 15px;

    font-weight: 600;

    margin-bottom: 5px;
}


.course-school {
    font-size: 12px;

    color: #777;

    margin-bottom: 8px;
}


.course-details {
    display: flex;

    flex-wrap: wrap;

    gap: 5px 10px;

    font-size: 11px;

    color: #777;

    margin-bottom: 10px;
}


/* =========================
   Teachers
   ========================= */

.teacher-section {
    display: flex;

    flex-direction: column;

    gap: 5px;
}


.teacher-row {
    display: flex;

    align-items: center;

    gap: 6px;
}


.teacher-row label {
    width: 22px;

    font-size: 12px;

    font-weight: 600;

    color: #666;
}


.teacher-row select {
    flex: 1;

    min-width: 0;

    padding: 5px 6px;

    border: 1px solid #ccc;

    border-radius: 5px;

    background: white;

    font-size: 12px;
}


/* =========================
   Holiday
   ========================= */

.holiday-cell {
    background: #fffaf0;
}


.holiday-label {
    padding: 6px 8px;

    margin-bottom: 8px;

    border-radius: 5px;

    background: #fff3cd;

    color: #856404;

    font-size: 12px;

    font-weight: 600;
}


.cancelled {
    opacity: 0.45;
}

.save-area {
    display: flex;
    justify-content: flex-end;
    margin-top: 15px;
}


.save-button {
    padding: 10px 20px;

    border: none;
    border-radius: 6px;

    background: #222;
    color: white;

    font-size: 14px;
    font-weight: 600;

    cursor: pointer;
}


.save-button:hover {
    opacity: 0.85;
}

.teacher-conflicts {
    margin-top: 10px;
}


.conflict-warning {
    padding: 8px 10px;

    border: 1px solid #e0b84c;
    border-radius: 6px;

    background: #fff8df;

    color: #7a5a00;

    font-size: 11px;
    font-weight: 600;
}


.conflict-details {
    margin-top: 4px;

    font-weight: 400;

    line-height: 1.4;
}


.conflict-details strong {
    font-weight: 600;
}

.teacher-leave-warnings {
    margin-top: 8px;
}


.leave-warning {
    padding: 8px 10px;

    border: 1px solid #d9a441;
    border-radius: 6px;

    background: #fff4d6;

    color: #7a5200;

    font-size: 11px;
    font-weight: 600;
}


.leave-details {
    margin-top: 4px;

    font-weight: 400;

    line-height: 1.4;
}

.inherited-label {
    margin-top: 6px;

    font-size: 10px;

    color: #888;

    font-style: italic;
}

.add-teacher-button {
    margin-top: 6px;

    padding: 5px 8px;

    border: 1px dashed #bbb;
    border-radius: 5px;

    background: white;

    color: #777;

    font-size: 11px;

    cursor: pointer;
}

.add-teacher-button:hover {
    background: #f5f5f5;
    color: #333;
}

.weekly-columns {
    display: grid;

    grid-template-columns:
        repeat(5, minmax(250px, 1fr));

    gap: 10px;

    align-items: start;
}


.day-column {
    min-width: 0;
}


.day-header {
    padding: 12px;

    text-align: center;

    background: white;

    border: 1px solid #ddd;

    border-radius: 8px;

    margin-bottom: 8px;
}


.day-name {
    font-size: 15px;
    font-weight: 600;
}


.day-date {
    margin-top: 3px;

    font-size: 12px;

    color: #777;
}


.day-courses {
    display: flex;

    flex-direction: column;

    gap: 8px;
}


.course-block {
    background: white;

    border: 1px solid #d9dee5;

    border-radius: 7px;

    padding: 9px 10px;
}


.course-school {
    font-size: 11px;

    font-weight: 700;

    color: #666;

    margin-bottom: 3px;
}


.course-name {
    font-size: 13px;

    font-weight: 600;

    line-height: 1.3;

    margin-bottom: 3px;
}


.course-time {
    font-size: 12px;

    font-weight: 600;

    color: #444;

    margin-bottom: 5px;
}


.course-details {
    display: flex;

    flex-wrap: wrap;

    gap: 3px 8px;

    font-size: 10px;

    color: #777;

    margin-bottom: 7px;
}


.empty-cell {
    min-height: 100px;

    display: flex;

    align-items: center;

    justify-content: center;

    color: #ccc;

    background: white;

    border: 1px solid #eee;

    border-radius: 7px;
}


/* =========================================
   School × Week Timetable
   ========================================= */

.school-timetable {
    display: grid;

    grid-template-columns:
        180px
        repeat(5, minmax(250px, 1fr));

    background: white;

    border: 1px solid #ddd;
    border-radius: 10px;

    overflow-x: auto;
}


/* -----------------------------------------
   Headers
   ----------------------------------------- */

.school-header,
.day-header {

    padding: 15px;

    background: #fafafa;

    border-bottom: 1px solid #ddd;

    font-weight: 600;

}


.school-header {
    display: flex;
    align-items: center;

    font-size: 14px;
}


.day-header {

    text-align: center;

    border-left: 1px solid #ddd;

}


.day-name {
    font-size: 15px;
}


.day-date {
    margin-top: 4px;

    font-size: 13px;

    color: #777;
}


/* -----------------------------------------
   School name
   ----------------------------------------- */

.school-name {

    padding: 15px;

    background: #fafafa;

    border-bottom: 1px solid #eee;

    display: flex;
    align-items: flex-start;

}


.school-name-main {

    font-size: 15px;

    font-weight: 600;

    word-break: break-word;
}


/* -----------------------------------------
   Day cells
   ----------------------------------------- */

.school-day-cell {

    min-height: 220px;

    padding: 10px;

    border-left: 1px solid #eee;
    border-bottom: 1px solid #eee;

    background: white;
}


